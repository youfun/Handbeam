<!-- Workspace HEEx template - Handbeam workspace/project sidebar layout -->
<div class={[
  "h-screen flex flex-col bg-main text-primary workspace-shell",
  if(@mobile_mode, do: "mobile-mode", else: "")
]}>
  <Layouts.flash_group flash={@flash} />
  <.mobile_header {assigns} />
  <div class="flex flex-1 overflow-hidden workspace-main">
    <.projects_sidebar {assigns} />
    <.chat_panel {assigns} />
    <.workspace_panel {assigns} />
    <.mobile_sheets {assigns} />
  </div>
  <.approval_overlay {assigns} />
  <.status_bar {assigns} />
</div>
