<div class={[
  "h-screen flex flex-col bg-main text-primary workspace-shell",
  if(@mobile_mode, do: "mobile-mode", else: "")
]}>
  <Layouts.flash_group flash={@flash} />
  <.mobile_header
    chat_scope={@chat_scope}
    conversations_by_workspace={@conversations_by_workspace}
    current_conversation_id={@current_conversation_id}
    current_workspace_id={@current_workspace_id}
    terminal_available?={@terminal_available?}
    workspace_label={@workspace_label}
    workspaces={@workspaces}
  />
  <div class="flex flex-1 overflow-hidden workspace-main">
    <.projects_sidebar
      chat_scope={@chat_scope}
      collapsed_workspace_ids={@collapsed_workspace_ids}
      conversation_menu_id={@conversation_menu_id}
      conversations_by_workspace={@conversations_by_workspace}
      current_conversation_id={@current_conversation_id}
      current_workspace_id={@current_workspace_id}
      show_archive={@show_archive}
      streams={@streams}
      workspace_menu_id={@workspace_menu_id}
      workspaces={@workspaces}
    />
    <.chat_panel
      add_project_form={@add_project_form}
      available_models={@available_models}
      available_reasoning_levels={@available_reasoning_levels}
      chat_scope={@chat_scope}
      composer_error={@composer_error}
      current_assistant_entry_id={@current_assistant_entry_id}
      current_conversation_id={@current_conversation_id}
      current_workspace_id={@current_workspace_id}
      file_browser_path={@file_browser_path}
      history_has_more?={@history_has_more?}
      input_value={@input_value}
      mobile_right_panel_open={@mobile_right_panel_open}
      pending_approval={@pending_approval}
      pending_attachments={@pending_attachments}
      pending_messages={@pending_messages}
      permission_mode={@permission_mode}
      remove_workspace={@remove_workspace}
      rename_conversation={@rename_conversation}
      revert_confirm_change_id={@revert_confirm_change_id}
      revert_message={@revert_message}
      right_panel_collapsed={@right_panel_collapsed}
      running={@running}
      sandbox_workspace?={@sandbox_workspace?}
      selected_model={@selected_model}
      selected_reasoning_level={@selected_reasoning_level}
      show_add_project={@show_add_project}
      show_file_browser={@show_file_browser}
      show_permission_menu={@show_permission_menu}
      skill_suggestions={@skill_suggestions}
      streams={@streams}
      timeline={@timeline}
      uploads={@uploads}
      workspace_root={@workspace_root}
    />
    <.workspace_panel
      active_file={@active_file}
      chat_scope={@chat_scope}
      current_workspace_id={@current_workspace_id}
      expanded_file_changes={@expanded_file_changes}
      expanded_workspace_dirs={@expanded_workspace_dirs}
      file_preview_error={@file_preview_error}
      mobile_right_panel_open={@mobile_right_panel_open}
      revert_confirm_change_id={@revert_confirm_change_id}
      revert_message={@revert_message}
      right_panel_collapsed={@right_panel_collapsed}
      right_panel_view={@right_panel_view}
      terminal_available?={@terminal_available?}
      timeline={@timeline}
      workspace_label={@workspace_label}
      workspace_root={@workspace_root}
      workspace_tree={@workspace_tree}
      workspace_tree_error={@workspace_tree_error}
    />
    <.mobile_sheets
      available_models={@available_models}
      available_reasoning_levels={@available_reasoning_levels}
      chat_scope={@chat_scope}
      collapsed_workspace_ids={@collapsed_workspace_ids}
      conversations_by_workspace={@conversations_by_workspace}
      current_conversation_id={@current_conversation_id}
      current_workspace_id={@current_workspace_id}
      mcp_count={@mcp_count}
      selected_model={@selected_model}
      selected_reasoning_level={@selected_reasoning_level}
      show_model_sheet={@show_model_sheet}
      show_reasoning_sheet={@show_reasoning_sheet}
      show_settings_sheet={@show_settings_sheet}
      show_workspace_sheet={@show_workspace_sheet}
      skills_count={@skills_count}
      status_info={@status_info}
      workspace_label={@workspace_label}
      workspaces={@workspaces}
    />
  </div>
  <.approval_overlay pending_approval={@pending_approval} />
  <.status_bar
    current_conversation_id={@current_conversation_id}
    current_workspace_id={@current_workspace_id}
    mcp_count={@mcp_count}
    skills_count={@skills_count}
    status_info={@status_info}
  />
</div>
