<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Handbeam" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/default.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/theme-system.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/theme-light.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/workspace.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/composer.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/motion.css"} />
    <script phx-track-static type="text/javascript" src={~p"/assets/js/phoenix.js"}>
    </script>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/phoenix_live_view.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      window.addEventListener("load", function () {
        if (window.liveSocket) return
        var LiveView = window.LiveView
        var Phoenix = window.Phoenix
        if (!LiveView || !LiveView.LiveSocket || !Phoenix || !Phoenix.Socket) return
        var csrf = document.querySelector("meta[name='csrf-token']")
        if (!csrf) return
        try {
          var liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
            params: {_csrf_token: csrf.getAttribute("content")},
            longPollFallbackMs: 2500
          })
          liveSocket.connect()
          window.liveSocket = liveSocket
        } catch (error) {
          console.error("Handbeam LiveSocket fallback failed", error)
        }
      })
    </script>
    <style>
      :root {
        --safe-bottom: env(safe-area-inset-bottom, 0px);
        --safe-top: env(safe-area-inset-top, 0px);
      }
      body { overscroll-behavior: none; -webkit-tap-highlight-color: transparent; }
      @media (max-width: 767px) { body { user-select: none; -webkit-user-select: none; } }

      /* ── Backdrop ── */
      .mobile-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 50; opacity: 0; pointer-events: none; transition: opacity 0.25s ease; }
      .mobile-backdrop.open { opacity: 1; pointer-events: auto; }

      /* ── Bottom Sheet ── */
      .bottom-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 51; background: var(--sig-bg-elevated); border-radius: 20px 20px 0 0; max-height: 76vh; overflow: hidden; transform: translateY(100%); transition: transform 0.32s cubic-bezier(0.22,1,0.36,1); padding-bottom: var(--safe-bottom); box-shadow: 0 -8px 40px rgba(0,0,0,0.12); display: flex; flex-direction: column; }
      .bottom-sheet.open { transform: translateY(0); }
      .bottom-sheet.dragging { transition: none !important; }
      .bottom-sheet-inner { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 0 0 16px; }
      .sheet-handle { width: 36px; height: 4px; background: var(--sig-border-emphasis); border-radius: 2px; margin: 10px auto 8px; cursor: grab; position: relative; touch-action: none; flex-shrink: 0; }
      .sheet-handle::after { content: ''; position: absolute; top: -16px; left: -24px; right: -24px; bottom: -16px; }

      /* ── Sheet list items ── */
      .sheet-section-title { padding: 14px 20px 6px; font-size: 13px; font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--sig-text-secondary); }
      .sheet-section-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding-right: 14px; }
      .sheet-section-name { display: flex; align-items: center; gap: 6px; min-width: 0; }
      .sheet-section-sub { font-size: 10px; font-weight: 400; color: var(--sig-text-tertiary); }
      .sheet-new-conv-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; min-width: 34px; border: none; border-radius: 10px; color: var(--sig-accent); background: transparent; cursor: pointer; outline: none; transition: background 0.12s, color 0.12s; touch-action: manipulation; }
      .sheet-new-conv-btn:active, .sheet-new-conv-btn:hover { background: var(--sig-accent-subtle); color: var(--sig-accent); }

      .sheet-conv-row { display: flex; align-items: center; gap: 8px; padding: 11px 20px; font-size: 14px; color: var(--sig-text-secondary); border: none; background: transparent; width: 100%; text-align: left; cursor: pointer; outline: none; transition: background 0.12s; min-height: 44px; touch-action: manipulation; }
      .sheet-conv-row:active, .sheet-conv-row:hover { background: var(--sig-bg-surface-hover); }
      .sheet-conv-row.active { color: var(--sig-text-primary); font-weight: 500; background: var(--sig-bg-surface-active); box-shadow: inset 2px 0 0 var(--sig-text-tertiary); }
      .sheet-conv-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sig-border-emphasis); flex-shrink: 0; }
      .sheet-conv-dot.active { background: var(--sig-text-secondary); }
      .sheet-conv-time { font-size: 10px; color: var(--sig-text-tertiary); flex-shrink: 0; }

      .sheet-ws-row { display: flex; align-items: center; gap: 12px; padding: 11px 20px; font-size: 14px; color: var(--sig-text-primary); border: none; background: transparent; width: 100%; text-align: left; cursor: pointer; outline: none; transition: background 0.12s; min-height: 44px; touch-action: manipulation; }
      .sheet-ws-row:active, .sheet-ws-row:hover { background: var(--sig-bg-surface-hover); }
      .sheet-ws-check { color: var(--sig-accent); font-weight: bold; font-size: 14px; flex-shrink: 0; }

      .sheet-add-row { display: flex; align-items: center; gap: 12px; padding: 14px 20px; font-size: 13px; color: var(--sig-accent); font-weight: 500; border: none; background: transparent; width: 100%; text-align: left; cursor: pointer; outline: none; transition: background 0.12s; min-height: 44px; touch-action: manipulation; border-top: 1px solid var(--sig-border-subtle); margin-top: 8px; }
      .sheet-add-row:active { background: var(--sig-bg-surface-hover); }

      .sheet-select-row { display: flex; align-items: center; gap: 8px; padding: 11px 20px; font-size: 14px; color: var(--sig-text-primary); border: none; background: transparent; width: 100%; text-align: left; cursor: pointer; outline: none; transition: background 0.12s; min-height: 44px; touch-action: manipulation; }
      .sheet-select-row:active, .sheet-select-row:hover { background: var(--sig-bg-surface-hover); }
      .sheet-select-row.active { background: var(--sig-accent-subtle); color: var(--sig-accent); font-weight: 600; }
      .sheet-select-check { font-size: 14px; font-weight: bold; flex-shrink: 0; color: var(--sig-accent); }

      /* ── Side Drawer (file viewer) ── */
      .side-drawer { position: fixed; top: 0; right: 0; bottom: 0; width: 100%; z-index: 40; background: var(--sig-bg-elevated); transform: translateX(100%); transition: transform 0.28s cubic-bezier(0.22,1,0.36,1); display: flex; flex-direction: column; touch-action: pan-y; }
      .side-drawer.open { transform: translateX(0); }
      .side-drawer.swiping { transition: none !important; }

      /* ── Mobile Header v2 ── */
      .mobile-header-v2 { display: none; }
      @media (max-width: 767px) {
        .mobile-header-v2 { display: flex; }
      }
      .mobile-header-v2 { align-items: center; gap: 4px; padding: 8px 10px 6px; border-bottom: 1px solid var(--sig-border-default); background: var(--sig-bg-elevated); flex-shrink: 0; z-index: 20; }
      .mobile-header-workspace-btn { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; border: none; background: none; cursor: pointer; outline: none; padding: 4px 8px; border-radius: 10px; transition: background 0.12s; min-height: 44px; touch-action: manipulation; }
      .mobile-header-workspace-btn:active { background: var(--sig-bg-surface-hover); }
      .mobile-chevron { flex-shrink: 0; color: var(--sig-text-tertiary); }
      .mobile-header-settings-btn { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; border: none; background: transparent; color: var(--sig-text-tertiary); cursor: pointer; outline: none; flex-shrink: 0; transition: background 0.12s, color 0.12s; min-height: 44px; min-width: 44px; touch-action: manipulation; }
      .mobile-header-settings-btn:active { background: var(--sig-bg-surface-hover); color: var(--sig-text-primary); }
      .mobile-header-title { display: flex; align-items: center; gap: 10px; min-width: 0; }
      .mobile-brand { font-size: 15px; font-weight: 700; color: var(--sig-text-primary); }
      .mobile-workspace { font-size: 12px; color: var(--sig-text-secondary); }

      /* ── Mobile FAB ── */
      .mobile-fab { position: fixed; bottom: 24px; right: 16px; width: 40px; height: 40px; border-radius: 10px; background: var(--sig-accent); color: var(--sig-text-inverse); display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(26,24,21,0.12); transition: transform 0.22s cubic-bezier(0.22,1,0.36,1), opacity 0.22s cubic-bezier(0.22,1,0.36,1); z-index: 30; cursor: pointer; border: none; outline: none; touch-action: manipulation; }
      .mobile-fab.hidden { opacity: 0; transform: translateY(16px) scale(0.8); pointer-events: none; }
      .mobile-fab:active { transform: scale(0.92); }
      .mobile-fab-badge { position: absolute; top: -4px; right: -4px; min-width: 18px; height: 18px; border-radius: 9px; background: var(--sig-error); color: var(--sig-text-inverse); font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; padding: 0 4px; }
      .mobile-fab-badge:empty { display: none; }

      @media (min-width: 768px) {
        .mobile-backdrop,
        .bottom-sheet,
        .side-drawer {
          display: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div id="mob-bridge" phx-hook="MobHook" style="display:none"></div>
    {@inner_content}
  </body>
</html>
