# Handbeam 本地 Web UI 默认配置
# 所有变量均可用环境变量覆盖

# 启用 HTTP server
export PHX_SERVER=true

# 端口
export PORT="${PORT:-5008}"

# 主机名（本地使用）
export PHX_HOST="${PHX_HOST:-localhost}"

# 数据库路径（与 models.json 同目录 ~/.handbeam/）
export DATABASE_PATH="${DATABASE_PATH:-$HOME/.handbeam/handbeam.db}"

# Release 运行状态和 daemon 日志必须放在内置磁盘。工作区或 release
# 位于可移除磁盘时，掉盘后的日志仍可用于诊断进程退出。
export HANDBEAM_RUNTIME_DIR="${HANDBEAM_RUNTIME_DIR:-$HOME/.handbeam/runtime}"
umask 077
mkdir -p "$HANDBEAM_RUNTIME_DIR"
export RELEASE_TMP="${RELEASE_TMP:-$HANDBEAM_RUNTIME_DIR}"
export ERL_CRASH_DUMP="${ERL_CRASH_DUMP:-$HANDBEAM_RUNTIME_DIR/erl_crash.dump}"

# Session 密钥（未设置则自动生成，重启后 session 失效）
export SECRET_KEY_BASE="${SECRET_KEY_BASE:-$(openssl rand -base64 48 2>/dev/null || echo 'dev-fallback-not-for-production')}"
