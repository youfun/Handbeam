# Guest preview image: OTP release only, no Elixir source.
# Build context must be a directory that contains rel/handbeam/ from
# mix release (or scripts/build_local_release.sh).
#
#   mkdir -p /tmp/handbeam-guest-ctx/rel
#   cp -a _build/local_release/prod/rel/handbeam /tmp/handbeam-guest-ctx/rel/handbeam
#   cp Dockerfile.guest /tmp/handbeam-guest-ctx/Dockerfile
#   docker build -t handbeam-guest:local /tmp/handbeam-guest-ctx
FROM debian:bookworm-slim

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      libssl3 libncurses6 ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/handbeam
COPY rel/handbeam/ ./

ENV PHX_SERVER=true \
    PORT=4000 \
    HOME=/data \
    DATABASE_PATH=/data/sigil.db \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

EXPOSE 4000
USER nobody
CMD ["bin/handbeam", "start"]
