# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/
tmp-config/
test/fixtures/*
!test/fixtures/sample.txt

# Ignore package tarball (built via "mix hex.build").
handbeam-*.tar

# Project-level model config (may contain API keys)
models.json
modejs.json

# Database files
*.db
*.db-*
/node_modules/

# Generated Mix/Hex/ExUnit toolchain for mobile packaging
/priv/mix_toolchain/
/mobile/priv/mix_toolchain/

# Build artifacts (generated by mix assets.build / mix assets.deploy)
/priv/static/assets/
/priv/static/cache_manifest.json
/priv/static/**/*-????????????????????????????????.*
/priv/static/**/*.gz
!/priv/static/uploads/

# macOS
.DS_Store

# Local dev artifacts
test_rendered.html
mobile-ux-demo*.html

# MCP config (may contain API keys)
.mcp.json
.mcp.json.bak

# Local runtime data
.handbeam/
.playwright-mcp/

# Temporary screenshots / assets
terminal-*.png
/ios_verify_startup_error.png

# Local archive of retired documentation
/.local-archive/

# Editor / agent sidecar
.antigravitycli/
